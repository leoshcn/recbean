# Copy to .env on the server (never commit .env). Real credentials live only there.

# Doubao streaming ASR credentials (Volcengine console).
# New console (recommended): a single API key, sent as X-Api-Key.
#   https://console.volcengine.com/speech/new/setting/apikeys
DOUBAO_API_KEY=
# Old console alternative (used only when DOUBAO_API_KEY is empty):
# APP_KEY (App ID) + ACCESS_KEY (Access Token).
# DOUBAO_APP_KEY=
# DOUBAO_ACCESS_KEY=

# 豆包流式语音识别模型 2.0 小时版
DOUBAO_RESOURCE_ID=volc.seedasr.sauc.duration

# Data directory inside the container (mounted from ./data by docker-compose).
DATA_DIR=/data

# Optional:
# RESUME_TIMEOUT_S=30        # seconds to wait for a device to resume after a disconnect
# TZ_NAME=Asia/Shanghai      # timezone for default titles and TXT export
# LOG_LEVEL=INFO
